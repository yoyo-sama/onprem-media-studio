# Settings of the Docker installation, read by docker compose. scripts/docker-install.sh copies
# this file to .env once (readable by you only); edit .env, never this file, then apply a
# change with: docker compose up -d
# Lines starting with # keep the default shown.

# Hugging Face token, for gated models (Krea 2): accept the licence on the model page first.
HF_TOKEN=

# GitHub token for in-app updates, only if you run a PRIVATE fork of the repository
# (fine-grained, Contents: read-only). The public repository needs none.
#STUDIO_GIT_TOKEN=

# Host port of the interface. AI Content Studio 1.4 uses 8090: take another one (8096) on a
# machine where it runs.
#STUDIO_HOST_PORT=8090

# Models and renders (plan for 300 GB). Relative paths start from this folder.
#STUDIO_DATA=./data

# Branch the in-app update follows.
#STUDIO_UPDATE_BRANCH=main

# Product name shown in the interface (empty: the name set in studio/config.py).
#STUDIO_APP_NAME=

# LLM of the assistant and the prompt enrichments (catalog id; the only one qualified).
#STUDIO_LLM_MODEL=gemma4-26b-a4b
